{
  "family": "webhook-delivery-service-worker",
  "networkMode": "awsvpc",
  "requiresCompatibilities": ["FARGATE"],
  "cpu": "256",
  "memory": "512",
  "executionRoleArn": "${EXECUTION_ROLE_ARN}",
  "taskRoleArn": "${TASK_ROLE_ARN}",
  "containerDefinitions": [
    {
      "name": "worker",
      "image": "${AWS_ACCOUNT_ID}.dkr.ecr.${AWS_REGION}.amazonaws.com/webhook-delivery-service:${IMAGE_TAG}",
      "essential": true,
      "environment": [
        {
          "name": "NODE_ENV",
          "value": "production"
        },
        {
          "name": "PORT",
          "value": "3000"
        },
        {
          "name": "LOG_LEVEL",
          "value": "info"
        },
        {
          "name": "SECRETS_SOURCE",
          "value": "aws"
        },
        {
          "name": "SECRET_ID",
          "value": "${SECRET_ID}"
        },
        {
          "name": "AWS_REGION",
          "value": "${AWS_REGION}"
        },
        {
          "name": "ALLOW_PRIVATE_ENDPOINTS",
          "value": "false"
        },
        {
          "name": "DELIVERY_TIMEOUT_MS",
          "value": "10000"
        },
        {
          "name": "DELIVERY_BATCH_SIZE",
          "value": "10"
        },
        {
          "name": "DELIVERY_LEASE_SECONDS",
          "value": "60"
        },
        {
          "name": "RETRY_SCHEDULE_SECONDS",
          "value": "5,300,1800,7200,18000,36000"
        },
        {
          "name": "CIRCUIT_BREAKER_THRESHOLD",
          "value": "20"
        }
      ],
      "healthCheck": {
        "command": ["CMD-SHELL", "wget -qO- http://127.0.0.1:3000/health > /dev/null || exit 1"],
        "interval": 30,
        "timeout": 5,
        "retries": 3,
        "startPeriod": 20
      },
      "logConfiguration": {
        "logDriver": "awslogs",
        "options": {
          "awslogs-group": "/ecs/webhook-delivery-service",
          "awslogs-region": "${AWS_REGION}",
          "awslogs-stream-prefix": "worker"
        }
      },
      "command": ["node", "dist/scripts/start-with-secrets.js", "worker"]
    }
  ]
}
