# --- Runtime ---
NODE_ENV=development
PORT=3000
LOG_LEVEL=info

# --- Secrets loading (scripts/start-with-secrets.ts) ---
# local: use this .env file. aws: fetch one JSON secret from AWS Secrets Manager.
SECRETS_SOURCE=local
SECRET_ID=
AWS_REGION=

# --- Database ---
DATABASE_URL=postgresql://app:app@localhost:5447/webhooks

# --- Admin API key (creating applications) ---
ADMIN_API_KEY=change-me-admin-api-key

# --- SSRF protection ---
# Endpoint URLs that resolve to private, loopback or link-local addresses are rejected.
# Set to true ONLY for local development (the docker-compose receiver is on a private network).
ALLOW_PRIVATE_ENDPOINTS=true

# --- Delivery ---
DELIVERY_TIMEOUT_MS=10000
DELIVERY_BATCH_SIZE=10
# How long a claimed delivery stays hidden from other workers. Must exceed DELIVERY_TIMEOUT_MS.
DELIVERY_LEASE_SECONDS=60
POLL_INTERVAL_MS=1000
# Delays (seconds) before each retry; one attempt plus one per entry. Each gets ±RETRY_JITTER.
RETRY_SCHEDULE_SECONDS=5,300,1800,7200,18000,36000
RETRY_JITTER=0.2
# Consecutive failed attempts before an endpoint is disabled (circuit breaker).
CIRCUIT_BREAKER_THRESHOLD=20
# How long a rotated-out signing secret keeps signing.
SECRET_ROTATION_GRACE_HOURS=24
